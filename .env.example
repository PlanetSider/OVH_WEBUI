# ═══════════════════════════════════════════════════════════
# OVH_WEBUI · Docker Compose 部署环境变量
# cp .env.example .env
# 切勿提交真实 .env 到 git
# ═══════════════════════════════════════════════════════════

# —— 访问鉴权 ——
# 至少 8 位，并同时包含英文大写、英文小写和数字；请使用密码生成器生成随机值。
API_SECRET_KEY=REPLACE_WITH_RANDOM_KEY
# 必须使用经审核的不可变 digest，禁止 latest。
OVH_WEBUI_IMAGE=ghcr.io/planetsider/ovh-webui@sha256:REPLACE_WITH_REVIEWED_DIGEST
TG_WEBHOOK_SECRET=
# Webhook secret 校验强制开启，不能改为 true。
TG_WEBHOOK_SECRET_OPTIONAL=false
# 飞书首次绑定允许的 open_id，逗号分隔；已有绑定不会被其他用户覆盖。
FEISHU_ALLOWED_OPEN_IDS=

# SQLite 敏感凭据加密密钥（可选）。为空时首次启动在 DATA_DIR/config.key
# 生成并保护一个随机密钥；设置后优先使用此值，轮换前请先完成数据迁移。
OVH_DB_KEY=
