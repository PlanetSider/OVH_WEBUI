# ═══════════════════════════════════════════════════════════
# OVH_WEBUI · Docker Compose 部署环境变量
# cp .env.example .env
# 切勿提交真实 .env 到 git
# ═══════════════════════════════════════════════════════════

# —— 访问鉴权 ——
API_SECRET_KEY=change-me-to-a-long-random-string
TG_WEBHOOK_SECRET=
# 默认关闭；仅开发环境需要跳过 Telegram secret 校验时才改为 true
TG_WEBHOOK_SECRET_OPTIONAL=false

# SQLite 敏感凭据加密密钥（可选）。为空时首次启动在 DATA_DIR/config.key
# 生成并保护一个随机密钥；设置后优先使用此值，轮换前请先完成数据迁移。
OVH_DB_KEY=
