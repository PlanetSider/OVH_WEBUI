# —— 访问鉴权 ——
API_SECRET_KEY=change-me-to-a-long-random-string
TG_WEBHOOK_SECRET=
# 默认关闭；仅开发环境需要跳过 Telegram secret 校验时才改为 true
TG_WEBHOOK_SECRET_OPTIONAL=false
