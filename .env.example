# ═══════════════════════════════════════════════════════════
# OVH_WEBUI · Docker Compose 部署环境变量
# cp .env.example .env
# 切勿提交真实 .env 到 git
# ═══════════════════════════════════════════════════════════

# —— 访问鉴权（前端登录 / 脚本 X-API-Key）——
API_SECRET_KEY=change-me-to-a-long-random-string
ENABLE_API_KEY_AUTH=true

# —— 时区 ——
TZ=Asia/Shanghai

# —— 镜像与端口 ——
# 默认拉取 GHCR 的 latest；生产环境可固定为 sha-<commit> 或 vX.Y.Z
GHCR_OWNER=planetsider
OVH_IMAGE_TAG=latest
APP_PORT=19998

# 如果前面已有 HTTPS 反向代理，可填写公网根 URL
# PUBLIC_BASE_URL=https://ovh.example.com

# Telegram Webhook 完整地址（HTTPS 由外部反向代理提供）：
#   https://ovh.example.com/api/telegram/webhook
# 该路径免 API Key，但必须通过 Telegram secret_token 校验（X-Telegram-Bot-Api-Secret-Token）

# 可选：固定 Webhook secret（推荐生产设置；不设则首次 setWebhook 时自动生成并落盘）
# TG_WEBHOOK_SECRET=long-random-hex-string
# 仅开发环境可设为 true 跳过 secret 校验（生产切勿开启）
# TG_WEBHOOK_SECRET_OPTIONAL=false

# 可选：烟测目标机
# SMOKE_ALLOWED_SERVER=
