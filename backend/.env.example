# ═══════════════════════════════════════════════════════════
# OVH_WEBUI 后端环境变量样板
# 复制为 .env 后修改（.env 已被 gitignore，切勿提交）
#   Windows:  copy .env.example .env
#   或运行:   ..\scripts\init-first-run.ps1
# ═══════════════════════════════════════════════════════════

# HTTP
PORT=19998
LISTEN_HOST=
GIN_MODE=release
DEBUG=false

# 网关鉴权：前端 / 脚本请求头 X-API-Key 必须与此一致
# 至少 8 位，并同时包含英文大写、英文小写和数字；生产环境请使用随机值。
API_SECRET_KEY=REPLACE_WITH_RANDOM_KEY
# 鉴权是强制开启的，设置为 false 会导致服务启动失败。
ENABLE_API_KEY_AUTH=true

# 持久化目录（账户 / 队列 / 缓存 / 日志），相对 backend 工作目录或绝对路径
DATA_DIR=data

# 说明：
# - OVH_DB_KEY 可选：优先于旧的 DATA_DIR/.dbkey；建议使用 openssl rand -hex 32
#   并将其作为容器 secret 管理。未设置且没有旧 .dbkey 时会生成 DATA_DIR/config.key。
# - OVH Application Key / Secret / Consumer Key 请在前端「设置 → OVH 账户」添加
#   （多账户模型，不再依赖此处写死单套凭据）
# - Telegram Token / Chat ID 可在前端「设置 → Telegram」配置
# - FEISHU_ALLOWED_OPEN_IDS 可用逗号分隔显式允许首次绑定的飞书 open_id
# - 线上巡检已下线，无需 INSPECTION_* 变量
